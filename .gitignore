# Environments / secrets
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
dist/
build/
*.egg-info/

# Node / Next.js
node_modules/
.turbo/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Data / artifacts (downloaded corpus files are large, never check in)
/data/downloads/*
!/data/downloads/.gitkeep

# Converted Markdown corpus is regenerated from data/downloads/, never check in
/data/markdown/*
!/data/markdown/.gitkeep

# Docling structured documents (chunking input) are regenerated from data/downloads/, never check in
/data/docling/*
!/data/docling/.gitkeep
*.parquet

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Logs
*.log
logs/
